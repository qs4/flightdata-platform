# Copy to .env and adjust. .env is git-ignored -- never commit real credentials.

# Optional: OpenSky OAuth2 client credentials (created in your OpenSky account).
# Without them the client runs anonymously, with much lower rate limits.
FLIGHTDATA_OPENSKY_CLIENT_ID=
FLIGHTDATA_OPENSKY_CLIENT_SECRET=

# Used when running outside Docker (docker compose sets its own value).
# FLIGHTDATA_DATABASE_URL=postgresql+psycopg://flightdata:flightdata@localhost:5432/flightdata

# Seconds between OpenSky polls.
# FLIGHTDATA_INGEST_INTERVAL_SECONDS=120

# Bounding box that is polled (default: roughly Germany).
# FLIGHTDATA_BBOX_LAMIN=47.3
# FLIGHTDATA_BBOX_LOMIN=5.9
# FLIGHTDATA_BBOX_LAMAX=55.1
# FLIGHTDATA_BBOX_LOMAX=15.1
